          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/material": "^21.1.5",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@ngrx/signals": "^21.1.1",
    "immer": "^11.1.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "autoprefixer": "^10.4.22",
    "gh-pages": "^6.3.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.7",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
