{
  "name": "formulator",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:builder": "ng serve formulator-builder",
    "start:responder": "ng serve formulator-responder",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:schema": "vitest run projects/schema"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
