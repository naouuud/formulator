{
  "openapi": "3.1.0",
  "info": {
    "title": "Formulator API",
    "version": "0.1.0",
    "description": "REST API contract for the Formulator form builder application.\n\nDerived from the Angular client (`SpreadService`, `SnapService`, `SpillService`), wire DTOs,\nand the mock HTTP interceptor that simulates the backend during local development.\n\n**Spreads** are editable form drafts. **Snaps** are immutable published snapshots\nof a spread's schema, used for response collection. A **spill** is an unique instance of a snap shared for response collection, and contains the response schema.\n\nDeleting a spread does not delete its snaps; affected snaps become orphans with\n`spreadId` set to null. Deleting a snap does not affect any of its spills.\n"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development backend"
    }
  ],
  "tags": [
    {
      "name": "Spreads",
      "description": "CRUD operations for editable form/survey spreads"
    },
    {
      "name": "Snaps",
      "description": "Publish and manage immutable spread snapshots"
    },
    {
      "name": "Spills",
      "description": "Share a snap to collect responses"
    }
  ],
  "paths": {
    "/spreads": {
      "get": {
        "tags": [
          "Spreads"
        ],
        "operationId": "listSpreads",
        "summary": "List spread metadata",
        "description": "Returns metadata for all spreads without the full page/element tree.\n",
        "responses": {
          "200": {
            "description": "List of spread metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpreadMetaDataDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Spreads"
        ],
        "operationId": "createSpread",
        "summary": "Create a new spread",
        "description": "Creates a new spread with `version` 0, a default schema (one empty page), spread title,\nand current timestamps.\n\nRequest body must provide `spreadTitle`. UUID is server-generated unless `id` is set in body (avoid setting `id` manually except for testing).\n\nReturns **409 Conflict** when `spreadTitle` is already in use or when a client-provided `id` already exists.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSpreadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Spread created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpreadDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/spreads/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SpreadId"
        }
      ],
      "get": {
        "tags": [
          "Spreads"
        ],
        "operationId": "getSpreadById",
        "summary": "Get spread by ID",
        "description": "Returns the full spread including its schema (title, pages, and elements).",
        "responses": {
          "200": {
            "description": "Spread found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpreadDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/SpreadNotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Spreads"
        ],
        "operationId": "updateSpread",
        "summary": "Update spread",
        "description": "Updates a spread by ID. Used for auto-save.\n\nRequired body fields: `id`, `version`, `spreadTitle`, and `schema`.\nThe path `id` and request body `id` must match.\n\nOptimistic concurrency is enforced via the `version` field: the request body\nmust carry the current version. On success the server increments `version`,\nupdates `spreadTitle` and `schema`, and refreshes `lastModifiedAt`.\n\nReturns **409 Conflict** for a version mismatch or when `spreadTitle` is\nalready used by another spread.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSpreadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Spread updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpreadDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/SpreadNotFound"
          },
          "409": {
            "description": "Version conflict or duplicate spread title",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/VersionConflictDetail"
                    },
                    {
                      "$ref": "#/components/schemas/ProblemDetail"
                    }
                  ]
                },
                "examples": {
                  "versionConflict": {
                    "value": {
                      "status": 409,
                      "title": "Version conflict",
                      "detail": "Expected version 2 but found 3.",
                      "code": "VERSION_CONFLICT",
                      "expectedVersion": 2,
                      "actualVersion": 3
                    }
                  },
                  "duplicateSpreadTitle": {
                    "value": {
                      "status": 409,
                      "title": "Conflict",
                      "detail": "duplicate spread title.",
                      "code": "CONFLICT"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Spreads"
        ],
        "operationId": "deleteSpread",
        "summary": "Delete spread",
        "description": "Deletes a spread by ID. Does not delete associated snaps; published snaps\nmay become orphans referencing a spread that no longer exists.\n",
        "responses": {
          "204": {
            "description": "Spread deleted"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/SpreadNotFound"
          }
        }
      }
    },
    "/snaps": {
      "get": {
        "tags": [
          "Snaps"
        ],
        "operationId": "listSnaps",
        "summary": "List snap metadata",
        "description": "Returns metadata for snaps. When `spreadId` is provided, returns only snaps\npublished from that spread. When omitted, returns all snaps.\n\nThe `title` field is denormalized from `schema.title` on the full snap.\n\nOrphan editions (source spread deleted) are included when listing all snaps\nand have `spreadId: null`.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/SpreadIdQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "List of snap metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SnapMetaDataDto"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          }
        }
      },
      "post": {
        "tags": [
          "Snaps"
        ],
        "operationId": "createSnap",
        "summary": "Publish a snap",
        "description": "Publishes an immutable snapshot of a spread's current schema.\n\n- Deep-clones the spread's `schema` at publish time (spread row unchanged).\n- Sets `schema.title` on the snap from `snapTitle`.\n- Records `spreadVersion` from the spread's current `version`.\n- Assigns `edition` as the highest existing edition for that spread plus\n  one (starting at 1).\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSnapRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Snap published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/SpreadNotFound"
          }
        }
      }
    },
    "/snaps/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SnapId"
        }
      ],
      "get": {
        "tags": [
          "Snaps"
        ],
        "operationId": "getSnapById",
        "summary": "Get snap by ID",
        "description": "Returns the full snap including its immutable schema snapshot.",
        "responses": {
          "200": {
            "description": "Snap found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/SnapNotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Snaps"
        ],
        "operationId": "deleteSnap",
        "summary": "Delete snap",
        "description": "Removes the snap from the builder. After a successful delete, list and get\nrequests for that snap return 404 \u2014 a hard delete from the client's perspective.\n\nThe server retains the snap record internally (soft-close) so existing spills\ncan still resolve the published schema for response data.\n",
        "responses": {
          "204": {
            "description": "Snap removed from the client; no longer returned by list or get"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/SnapNotFound"
          }
        }
      }
    },
    "/spills": {
      "get": {
        "tags": [
          "Spills"
        ],
        "operationId": "listSpills",
        "summary": "List spill metadata",
        "description": "Returns metadata for all spills matching the provided `snapId`, omitting the response schema.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/SnapIdQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "List of spill metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpillMetaDataDto"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          }
        }
      },
      "post": {
        "tags": [
          "Spills"
        ],
        "operationId": "createSpill",
        "summary": "Share a spill",
        "description": "Creates a unique response collection record for a responder.\n\n- Request body must provide `snapId` and `email` (responder's email).\n- Optionally, `firstName` and `lastName` (of responder) can be provided.\n- Creates `rSchema` (response schema)  holding references to schema questions by id and answers initialized to empty string.\n- Originating schema is inferred from `snapId`, no clone is created.\n- Properties `lastModifiedAt` and `completedAt` are initialized to null.\n- Spill `id` acts as the unique token when sharing the spill instance with responder.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSpillRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Spill created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpillMetaDataDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/SnapNotFound"
          }
        }
      }
    },
    "/spills/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SpillId"
        }
      ],
      "delete": {
        "tags": [
          "Spills"
        ],
        "operationId": "deleteSpill",
        "summary": "Delete spill",
        "responses": {
          "204": {
            "description": "Spill deleted"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/SpillNotFound"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "InvalidRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "examples": {
              "invalidRequestBody": {
                "value": {
                  "status": 400,
                  "title": "Invalid request body",
                  "code": "INVALID_REQUEST"
                }
              },
              "missingSpreadId": {
                "value": {
                  "status": 400,
                  "title": "Invalid request body",
                  "detail": "spreadId is required.",
                  "code": "INVALID_REQUEST"
                }
              },
              "invalidSpreadId": {
                "value": {
                  "status": 400,
                  "title": "Invalid request body",
                  "detail": "spreadId must be a valid UUID.",
                  "code": "INVALID_REQUEST"
                }
              },
              "invalidId": {
                "value": {
                  "status": 400,
                  "title": "Invalid request body",
                  "detail": "id must be a valid UUID.",
                  "code": "INVALID_REQUEST"
                }
              },
              "missingSpreadTitle": {
                "value": {
                  "status": 400,
                  "title": "Invalid request body",
                  "detail": "spreadTitle is required.",
                  "code": "INVALID_REQUEST"
                }
              },
              "spreadIdMismatch": {
                "value": {
                  "status": 400,
                  "title": "Spread id in path and body must match",
                  "code": "INVALID_REQUEST"
                }
              },
              "missingSnapId": {
                "value": {
                  "status": 400,
                  "title": "Invalid request body",
                  "detail": "snapId is required.",
                  "code": "INVALID_REQUEST"
                }
              },
              "invalidSnapId": {
                "value": {
                  "status": 400,
                  "title": "Invalid request body",
                  "detail": "snapId must be a valid UUID.",
                  "code": "INVALID_REQUEST"
                }
              }
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "examples": {
              "internalError": {
                "value": {
                  "status": 500,
                  "title": "Internal server error",
                  "code": "INTERNAL_ERROR"
                }
              }
            }
          }
        }
      },
      "SpreadNotFound": {
        "description": "Spread not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "examples": {
              "spreadNotFound": {
                "value": {
                  "status": 404,
                  "title": "Spread not found",
                  "detail": "No spread exists with id 00000000-0000-0000-0000-000000000000.",
                  "code": "SPREAD_NOT_FOUND"
                }
              }
            }
          }
        }
      },
      "SnapNotFound": {
        "description": "Snap not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "examples": {
              "snapNotFound": {
                "value": {
                  "status": 404,
                  "title": "Snap not found",
                  "detail": "No snap exists with id 00000000-0000-0000-0000-000000000000.",
                  "code": "SNAP_NOT_FOUND"
                }
              }
            }
          }
        }
      },
      "SpillNotFound": {
        "description": "Spill not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "examples": {
              "spillNotFound": {
                "value": {
                  "status": 404,
                  "title": "Spill not found",
                  "detail": "No spill exists with id 00000000-0000-0000-0000-000000000000.",
                  "code": "SPILL_NOT_FOUND"
                }
              }
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict \u2014 e.g. duplicate spread title or duplicate client-provided id",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "examples": {
              "duplicateSpreadTitle": {
                "value": {
                  "status": 409,
                  "title": "Conflict",
                  "detail": "duplicate spread title.",
                  "code": "CONFLICT"
                }
              },
              "duplicateId": {
                "value": {
                  "status": 409,
                  "title": "Conflict",
                  "detail": "duplicate id",
                  "code": "CONFLICT"
                }
              }
            }
          }
        }
      },
      "VersionConflict": {
        "description": "Version conflict \u2014 the spread was modified since the client last read it",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VersionConflictDetail"
            },
            "examples": {
              "versionConflict": {
                "value": {
                  "status": 409,
                  "title": "Version conflict",
                  "detail": "Expected version 2 but found 3.",
                  "code": "VERSION_CONFLICT",
                  "expectedVersion": 2,
                  "actualVersion": 3
                }
              }
            }
          }
        }
      }
    },
    "parameters": {
      "SpreadId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Spread UUID",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "SnapId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Snap UUID",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "SpillId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Spill UUID",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "SpreadIdQuery": {
        "name": "spreadId",
        "in": "query",
        "required": false,
        "description": "Filter snaps to those published from this spread",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "SnapIdQuery": {
        "name": "snapId",
        "in": "query",
        "required": true,
        "description": "Filter spills to those created from this snap",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "SpreadMetaDataDto": {
        "type": "object",
        "required": [
          "id",
          "spreadTitle",
          "createdAt",
          "lastModifiedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "spreadTitle": {
            "type": "string",
            "minLength": 1,
            "description": "Display title. Leading/trailing whitespace is trimmed; empty-after-trim is rejected."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastModifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "CreateSpreadRequest": {
        "type": "object",
        "required": [
          "spreadTitle"
        ],
        "additionalProperties": false,
        "properties": {
          "spreadTitle": {
            "type": "string",
            "description": "Display title."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Optional client-provided spread ID. When omitted, the server generates a UUID."
          }
        }
      },
      "UpdateSpreadRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "spreadTitle",
          "schema"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Must match the spread ID in the URL path."
          },
          "spreadTitle": {
            "type": "string",
            "description": "Builder display title for the spread."
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "Current spread version for optimistic locking."
          },
          "schema": {
            "$ref": "#/components/schemas/Schema",
            "description": "Form schema (pages and elements)."
          }
        }
      },
      "SpreadDto": {
        "type": "object",
        "required": [
          "id",
          "version",
          "spreadTitle",
          "schema",
          "createdAt",
          "lastModifiedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "spreadTitle": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "Optimistic locking counter; incremented on each successful update."
          },
          "schema": {
            "$ref": "#/components/schemas/Schema"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastModifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Schema": {
        "type": "object",
        "required": [
          "title",
          "pages"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Page"
            }
          }
        }
      },
      "CreateSnapRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spreadId",
          "snapTitle"
        ],
        "properties": {
          "spreadId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the spread to publish"
          },
          "snapTitle": {
            "type": "string",
            "description": "Immutable snap title"
          }
        }
      },
      "SnapMetaDataDto": {
        "type": "object",
        "required": [
          "id",
          "spreadId",
          "spreadVersion",
          "title",
          "edition",
          "publishedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "spreadId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "ID of the source spread. Null when the spread was deleted (orphan edition)."
          },
          "spreadVersion": {
            "type": "integer",
            "minimum": 0,
            "description": "Spread `version` at publish time."
          },
          "title": {
            "type": "string",
            "description": "Denormalized from `schema.title`."
          },
          "edition": {
            "type": "integer",
            "minimum": 1,
            "description": "Publish edition number for the source spread (1-based)."
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SnapDto": {
        "type": "object",
        "required": [
          "id",
          "spreadId",
          "spreadVersion",
          "edition",
          "schema",
          "publishedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "spreadId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "ID of the source spread. Null when the spread was deleted (orphan edition)."
          },
          "spreadVersion": {
            "type": "integer",
            "minimum": 0,
            "description": "Spread `version` at publish time."
          },
          "edition": {
            "type": "integer",
            "minimum": 1,
            "description": "Publish edition number for the source spread (1-based)."
          },
          "schema": {
            "$ref": "#/components/schemas/Schema",
            "description": "Immutable snapshot of the spread schema at publish time."
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateSpillRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapId",
          "email"
        ],
        "properties": {
          "snapId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the snap being shared"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Responder email"
          },
          "firstName": {
            "type": "string",
            "description": "Optional. Responder first name."
          },
          "lastName": {
            "type": "string",
            "description": "Optional. Responder last name."
          },
          "sentAt": {
            "type": "string",
            "format": "date-time",
            "description": "Optional. Defaults to now (immediate send) when omitted."
          }
        }
      },
      "SpillMetaDataDto": {
        "type": "object",
        "required": [
          "id",
          "snapId",
          "firstName",
          "lastName",
          "email",
          "createdAt",
          "lastModifiedAt",
          "completedAt",
          "sentAt",
          "expiredAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "snapId": {
            "type": "string",
            "format": "uuid"
          },
          "firstName": {
            "type": "string",
            "description": "Responder first name, can be empty string."
          },
          "lastName": {
            "type": "string",
            "description": "Responder last name, can be empty string."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Responder email for spill sharing."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastModifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Last modification by responder; null on create."
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "sentAt": {
            "type": "string",
            "format": "date-time",
            "description": "Set on create (immediate send) or supplied for scheduled send."
          },
          "expiredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Reserved; null on create until scheduling slice."
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "id",
          "title",
          "elements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Element"
            }
          }
        }
      },
      "Element": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/NoteElement"
          },
          {
            "$ref": "#/components/schemas/QuestionElement"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "note": "#/components/schemas/NoteElement",
            "question": "#/components/schemas/QuestionElement"
          }
        }
      },
      "NoteElement": {
        "type": "object",
        "required": [
          "id",
          "type",
          "el"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "const": "note"
          },
          "el": {
            "$ref": "#/components/schemas/Note"
          }
        }
      },
      "QuestionElement": {
        "type": "object",
        "required": [
          "id",
          "type",
          "el"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "const": "question"
          },
          "el": {
            "$ref": "#/components/schemas/Question"
          }
        }
      },
      "Note": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "Rich text content."
          }
        }
      },
      "Question": {
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/BaseQuestion"
              },
              {
                "type": "object",
                "required": [
                  "htmlType"
                ],
                "properties": {
                  "htmlType": {
                    "type": "string",
                    "enum": [
                      "text",
                      "date",
                      "date_time",
                      "calendar_date",
                      "clock_time"
                    ]
                  }
                }
              }
            ]
          },
          {
            "$ref": "#/components/schemas/OptionsQuestion"
          }
        ]
      },
      "BaseQuestion": {
        "type": "object",
        "required": [
          "label",
          "htmlType",
          "validators"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "Rich text label."
          },
          "htmlType": {
            "type": "string",
            "enum": [
              "text",
              "select",
              "radio",
              "checkbox",
              "date",
              "date_time",
              "calendar_date",
              "clock_time"
            ]
          },
          "validators": {
            "$ref": "#/components/schemas/Validators"
          }
        }
      },
      "OptionsQuestion": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseQuestion"
          },
          {
            "type": "object",
            "required": [
              "htmlType",
              "optionValueType",
              "options"
            ],
            "properties": {
              "htmlType": {
                "type": "string",
                "enum": [
                  "select",
                  "radio",
                  "checkbox"
                ]
              },
              "optionValueType": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "options": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Option"
                }
              }
            }
          }
        ]
      },
      "Option": {
        "type": "object",
        "required": [
          "id",
          "label",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      },
      "Validators": {
        "type": "object",
        "required": [
          "required"
        ],
        "properties": {
          "required": {
            "type": "boolean"
          },
          "pattern": {
            "type": "string"
          },
          "maxLengthChar": {
            "type": "integer",
            "minimum": 0
          },
          "maxLengthWord": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "required": [
          "status",
          "title",
          "code"
        ],
        "properties": {
          "status": {
            "type": "integer",
            "description": "HTTP status code"
          },
          "title": {
            "type": "string",
            "description": "Short human-readable summary"
          },
          "detail": {
            "type": "string",
            "description": "Explanation specific to this occurrence"
          },
          "code": {
            "type": "string",
            "enum": [
              "SPREAD_NOT_FOUND",
              "SNAP_NOT_FOUND",
              "SPILL_NOT_FOUND",
              "VERSION_CONFLICT",
              "INVALID_REQUEST",
              "INTERNAL_ERROR",
              "CONFLICT"
            ],
            "description": "Machine-readable error code"
          }
        }
      },
      "VersionConflictDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetail"
          },
          {
            "type": "object",
            "required": [
              "code",
              "expectedVersion",
              "actualVersion"
            ],
            "properties": {
              "code": {
                "type": "string",
                "const": "VERSION_CONFLICT"
              },
              "expectedVersion": {
                "type": "integer",
                "minimum": 0,
                "description": "Version sent by the client"
              },
              "actualVersion": {
                "type": "integer",
                "minimum": 0,
                "description": "Current version stored on the server"
              }
            }
          }
        ]
      }
    }
  }
}
